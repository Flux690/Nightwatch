{
  "name": "nightwarden",
  "version": "0.3.147",
  "private": true,
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "dev": "pnpm --filter @nightwarden/api --filter @nightwarden/console --parallel dev",
    "dev:docker-runner": "pnpm --filter @nightwarden/docker-runner dev",
    "dev:kubernetes-runner": "pnpm --filter @nightwarden/kubernetes-runner dev",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/cli": "0.1.17",
    "@types/dockerode": "4.0.1",
    "@types/node": "26.1.1",
    "esbuild": "0.28.1",
    "prettier": "3.9.5",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}

# apps/api/.env  — loaded by the API (run from apps/api).
# Copy to apps/api/.env and fill OPENAI_API_KEY.

# LLM provider (both adapters compiled in; pick one)
LLM_PROVIDER=openai                          # anthropic | openai

# OpenRouter (OpenAI-compatible) — used when LLM_PROVIDER=openai
OPENAI_API_KEY=                              # <- your OpenRouter key (sk-or-...)
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-oss-120b:free

# Anthropic native — used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# All durable state (nightwarden.db, secret.key, sandbox workspaces). Optional:
# defaults to ~/.nightwarden. Must be absolute if set.
# NIGHTWARDEN_DIR=/absolute/path/to/state

# AES-256-GCM key for sessions and the stored LLM key. Optional: self-generated
# into NIGHTWARDEN_DIR/secret.key and reused. Set it to own the value yourself.
# SECRET_KEY=

PORT=3000

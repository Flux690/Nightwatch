# apps/api/.env - copy to apps/api/.env. Nothing here is required; every value
# has a default. The LLM block seeds the database on first boot only, after
# which console Settings is the only place to change it.

# No default: unset means pick a provider in the console. Set it only with that
# provider's model and key, since naming one without both is refused.
# LLM_PROVIDER=openrouter          # anthropic | openrouter

# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# OPENROUTER_BASE_URL=             # default: openrouter.ai/api/v1

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# ANTHROPIC_BASE_URL=              # default: api.anthropic.com

# PORT=3000
# HOST=127.0.0.1                   # 0.0.0.0 accepts off-host traffic

# Runners dial back here and Alertmanager posts here, so localhost is not it.
# Default: the request's own origin, which is wrong behind a proxy.
# PUBLIC_URL=

# All durable state: nightwarden.db, secret.key, workspaces/, proxy/.
# Default: ~/.nightwarden. Absolute paths only.
# NIGHTWARDEN_DIR=

# Encrypts sessions and every stored credential. Default: generated into
# NIGHTWARDEN_DIR/secret.key. Losing it makes those credentials unreadable.
# SECRET_KEY=

# Evidence integrations, seeded on first boot only and probed before they save.
# After that the console owns them.
# PROMETHEUS_URL=
# PROMETHEUS_AUTH_HEADER=          # verbatim Authorization value, stored encrypted
# LOKI_URL=
# LOKI_AUTH_HEADER=
# LOKI_ORG_ID=                     # X-Scope-OrgID, multi-tenant Loki only

# LOG_LEVEL=info                   # debug | info | warn | error

# Runner images the console's install artifacts hand out, one per platform;
# override to pin a tag or use a private registry.
# NIGHTWARDEN_DOCKER_RUNNER_IMAGE=ghcr.io/prabhatmattoo/nightwarden-docker-runner:latest
# NIGHTWARDEN_KUBERNETES_RUNNER_IMAGE=ghcr.io/prabhatmattoo/nightwarden-kubernetes-runner:latest

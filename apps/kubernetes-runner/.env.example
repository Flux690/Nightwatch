# apps/kubernetes-runner/.env - only read by `pnpm dev:kubernetes-runner`, which runs
# from source against your current kubeconfig context. A deployed runner never sees
# this file: the console's manifest passes every value as a container env entry.

# Mint one in the console under Integrations -> Kubernetes clusters. Shown once,
# stored hashed. A token minted for a Docker host is refused by this binary.
NIGHTWARDEN_TOKEN=nwr_local

# Every API route lives under /api. Use wss:// against an HTTPS install.
WS_URL=ws://localhost:3000/api/clients/connect

# LOG_LEVEL=info                   # debug | info | warn | error

# In-cluster the runner uses its ServiceAccount; from source it loads the default
# kubeconfig, so `kubectl config current-context` is the cluster it will report on.

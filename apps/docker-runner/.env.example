# apps/docker-runner/.env - only read by `pnpm dev:docker-runner`, which runs from
# source. A deployed runner never sees this file: the console's install command
# passes every value to `docker run -e`. Host metrics read /proc, so this needs Linux.

# Mint one in the console under Integrations -> Docker hosts. Shown once, stored
# hashed. A token minted for a Kubernetes cluster is refused by this binary.
NIGHTWARDEN_TOKEN=nwr_local

# Every API route lives under /api. Use wss:// against an HTTPS install.
WS_URL=ws://localhost:3000/api/clients/connect

# Host /proc, when the runner itself runs in a container. Default: /proc
# HOST_PROC=/host/proc

# Colon-separated paths added to the built-in ReadHostFile allowlist.
# FILE_ALLOWLIST=/etc/hosts:/var/log

# LOG_LEVEL=info                   # debug | info | warn | error

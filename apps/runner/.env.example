# apps/runner/.env  — loaded by the runner (run from apps/runner).
# Copy to apps/runner/.env. No secrets needed for local dev.

NIGHTWATCH_TOKEN=nwr_local                   # must match a runner token (mint one in the console)
WS_URL=ws://localhost:3000/clients/connect
NIGHTWATCH_SERVER_NAME=dev-host              # server label the runner advertises, used to route alerts to it
# HOST_PROC=/host/proc                       # set when running in container (default: /proc)

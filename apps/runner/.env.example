# apps/runner/.env - only read by `pnpm dev:runner`, which runs from source. A
# deployed runner never sees this file: the console's install command passes
# every value to `docker run -e`. Host metrics read /proc, so this needs Linux.

# Mint one in the console under Integrations -> Runner. Shown once, stored hashed.
NIGHTWARDEN_TOKEN=nwr_local

# Every API route lives under /api. Use wss:// against an HTTPS install.
WS_URL=ws://localhost:3000/api/clients/connect

# Matches the nw_server label on alerts, so one container name on two hosts
# stays distinct. Default: unscoped, which is fine for a single host.
# NIGHTWARDEN_SERVER_NAME=

# The Kubernetes equivalent. Default: an unscoped, single-cluster identity.
# NIGHTWARDEN_CLUSTER_NAME=

# Host /proc, when the runner itself runs in a container. Default: /proc
# HOST_PROC=/host/proc

# Colon-separated paths added to the built-in ReadHostFile allowlist.
# FILE_ALLOWLIST=/etc/hosts:/var/log

# LOG_LEVEL=info                   # debug | info | warn | error

# POSTGRES_URL and REDIS_URL are absent on purpose: if already in the runner's
# environment they are only probed, never used as NightWarden's own storage.
